# API server settings (read by srcs/api/dependencies.py).
# Copy to .env and fill in. .env is gitignored -- never commit real keys.
# The Slack bot reaches the LLM only through this API server.
# Note: the API rejects unknown keys here; put Slack tokens in .env.slack.

# FNAL LiteLLM gateway, OpenAI-compatible
ARTDAQ_LLM_PROVIDER=openrouter
ARTDAQ_OPENROUTER_BASE_URL=https://litellm.fnal.gov/v1
ARTDAQ_OPENROUTER_MODEL=azure/claude-haiku-5-5
ARTDAQ_OPENROUTER_REASONING_EFFORT=medium
# Match config.yaml llm.max_tokens; persona sub-calls get //3 and //10 of it
ARTDAQ_LLM_MAX_TOKENS=50000

# Embeddings through the same gateway (falls back to the openrouter key)
ARTDAQ_EMBEDDING_PROVIDER=openai
ARTDAQ_EMBEDDING_HOST=https://litellm.fnal.gov/v1
ARTDAQ_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# Virtual key from https://llm-keys.fnal.gov/ (starts with sk-)
ARTDAQ_OPENROUTER_API_KEY=sk-your-key-here
