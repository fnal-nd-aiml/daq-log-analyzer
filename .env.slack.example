# Slack tokens. Copy to .env.slack and fill in. .env.slack is gitignored.
# Sourced by slackbot.sh; read directly by tools/slackmonitorbot and
# tools/slacktesterbot. Each bot is a separate Slack app with its own tokens.
#   Bot token (xoxb-...): OAuth & Permissions -> Bot User OAuth Token
#   App token (xapp-...): Basic Information -> App-Level Tokens (connections:write)

# Main LogAnalyzer bot (slackbot.sh; overrides slack.* in config.yaml)
LOGANALYZER_SLACK_BOT_BOT_TOKEN=xoxb-your-bot-token
LOGANALYZER_SLACK_BOT_APP_TOKEN=xapp-your-app-token
# Only needed for HTTP mode (socket_mode: false)
# LOGANALYZER_SLACK_BOT_SIGNING_SECRET=

# Monitor bot (tools/slackmonitorbot)
SLACK_MONITOR_BOT_TOKEN=xoxb-your-monitor-bot-token
SLACK_MONITOR_APP_TOKEN=xapp-your-monitor-app-token

# Tester bot (tools/slacktesterbot)
SLACK_TESTER_BOT_TOKEN=xoxb-your-tester-bot-token
SLACK_TESTER_APP_TOKEN=xapp-your-tester-app-token
